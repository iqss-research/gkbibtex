#!/bin/sh
# Copy gk.bib, gkpubs.bib, and gkbib.tex into a paper folder (Overleaf / git).
# Usage: sync-gkbib [dest]
#   dest defaults to the current directory.
set -e
SRC=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
DEST=${1:-.}
cp -f "$SRC/gk.bib" "$SRC/gkpubs.bib" "$SRC/gkbib.tex" "$DEST/"
echo "copied gk.bib gkpubs.bib gkbib.tex -> $DEST"
